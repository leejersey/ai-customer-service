# 复制本文件为 .env，再填写你自己的密钥：
#     cp .env.example .env
# Windows 命令提示符可以用：copy .env.example .env
#
# .env 已被 .gitignore 忽略。不要提交它，也不要把真实密钥发给别人。

# 在 https://platform.deepseek.com 创建的 API Key。
# 下面这行是占位文字，不能用来调用接口。
DEEPSEEK_API_KEY=在这里粘贴你的DeepSeek密钥

# OpenAI SDK 使用的兼容接口地址。阶段 0 保持这一行不变。
# 不要写成 https://api.deepseek.com/chat/completions ，SDK 会自己补上路径。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 对话模型名。本学习项目约定先用 deepseek-chat。
# 如果运行时接口提示模型不存在或已下线，只把这一行改成 deepseek-flash，不用改代码。
DEEPSEEK_MODEL=deepseek-chat

# 阶段 3 可选。短期记忆放在这台 Redis。连不上时，脚本改用 fakeredis，并在屏幕上说明。
# 地址里如果写了密码，程序不会把它打印出来。下面这个地址没有密码。
REDIS_URL=redis://localhost:6379/0

# 会话多少秒没有访问就过期。1800 是 30 分钟。每次读写都会重新计时。
STAGE3_SESSION_TTL_SECONDS=1800

# 命令行没写会话编号时用这个名字。不写这一行，代码里用 local。
# STAGE3_SESSION_ID=local

# 阶段 4 仍使用上面的 DEEPSEEK_API_KEY、DEEPSEEK_BASE_URL、DEEPSEEK_MODEL。
# 检索在你自己的电脑上完成，不需要新的密钥。没有密钥时，示例 5 会跳过模型，示例 7 不联网。
